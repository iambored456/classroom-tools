{
  "name": "app-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Quinn Fleming's App Hub",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev-all.ts",
    "test:dev": "tsx --test scripts/lib/dev-readiness.test.ts",
    "dev:raw": "pnpm -r --parallel --filter hub --filter open-middle --filter class-clock --filter class-schedule-widget --filter classroom-connections --filter book-of-questions --filter literacy-flashcards --filter classroom-wordle --filter read-along-highlighter --filter launchpad-whack-a-mole --filter launchpad-snake --filter launchpad-reversi --filter launchpad-paint-war --filter launchpad-finger-twister --filter fish-visualizer --filter tax-brackets-marble-visual --filter coordinates --filter simple-compound-interest --filter oklch-visualizer --filter rugby-play-visualizer --filter city-navigator --filter paper-airplane-visualizer run dev",
    "dev:hub": "pnpm --filter hub run dev",
    "dev:open-middle": "pnpm --filter open-middle run dev",
    "dev:class-clock": "pnpm --filter class-clock run dev",
    "dev:class-schedule-widget": "pnpm --filter class-schedule-widget run dev",
    "dev:classroom-connections": "pnpm --filter classroom-connections run dev",
    "dev:book-of-questions": "pnpm --filter book-of-questions run dev",
    "dev:literacy-flashcards": "pnpm --filter literacy-flashcards run dev",
    "dev:classroom-wordle": "pnpm --filter classroom-wordle run dev",
    "dev:read-along": "pnpm --filter read-along-highlighter run dev",
    "dev:whack-a-mole": "pnpm --filter launchpad-whack-a-mole run dev",
    "dev:launchpad-snake": "pnpm --filter launchpad-snake run dev",
    "dev:launchpad-reversi": "pnpm --filter launchpad-reversi run dev",
    "dev:launchpad-paint-war": "pnpm --filter launchpad-paint-war run dev",
    "dev:launchpad-finger-twister": "pnpm --filter launchpad-finger-twister run dev",
    "dev:fish-visualizer": "pnpm --filter fish-visualizer run dev",
    "dev:tax-brackets-marble-visual": "pnpm --filter tax-brackets-marble-visual run dev",
    "dev:coordinates": "pnpm --filter coordinates run dev",
    "dev:simple-compound-interest": "pnpm --filter simple-compound-interest run dev",
    "dev:oklch-visualizer": "pnpm --filter oklch-visualizer run dev",
    "dev:rugby-play-visualizer": "pnpm --filter rugby-play-visualizer run dev",
    "dev:city-navigator": "pnpm --filter city-navigator run dev",
    "build": "pnpm -r --if-present run build",
    "build:fish-reweighted-data": "tsx scripts/build-fish-reweighted-data.ts",
    "build:pages": "tsx scripts/build-pages.ts",
    "capture:previews": "tsx scripts/capture-previews.ts",
    "verify:pages-links": "tsx scripts/verify-pages-links.ts",
    "preview": "pnpm run build:pages && tsx scripts/preview-pages.ts",
    "preview:hub": "pnpm --filter hub run preview",
    "preview:class-schedule-widget": "pnpm --filter class-schedule-widget run preview",
    "preview:oklch-visualizer": "pnpm --filter oklch-visualizer run preview",
    "typecheck": "pnpm -r --if-present run typecheck && tsc -p tsconfig.scripts.json",
    "clean": "pnpm -r exec rm -rf dist node_modules/.vite",
    "dev:paper-airplane": "pnpm --filter paper-airplane-visualizer run dev"
  },
  "author": "Quinn Fleming",
  "license": "MIT",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "playwright": "^1.58.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  }
}
